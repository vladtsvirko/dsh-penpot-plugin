{
  "name": "dsh-penpot-plugin",
  "version": "0.3.1",
  "description": "Penpot for DeepSeek Harness — read, export and import design files from a DSH agent over Penpot's local HTTP RPC API.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "COMPATIBILITY.md",
    "docs"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vladtsvirko/dsh-penpot-plugin.git"
  },
  "homepage": "https://github.com/vladtsvirko/dsh-penpot-plugin#readme",
  "bugs": {
    "url": "https://github.com/vladtsvirko/dsh-penpot-plugin/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "clean": "node -e \"require('node:fs').rmSync('lib',{recursive:true,force:true})\"",
    "prebuild": "npm run clean"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.6 <0.3.0-0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.10"
  },
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "penpot",
    "design"
  ],
  "publishConfig": {
    "access": "public"
  }
}
